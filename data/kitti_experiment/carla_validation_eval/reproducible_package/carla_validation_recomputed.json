      "0": "Pedestrian",
      "1": "Cyclist",
      "2": "IgnoreDontCare",
      "3": "IgnorePersonSitting"
    },
    "coordinate_conversion": "pixel_xyxy = ((center_x - width/2)*image_width, (center_y - height/2)*image_height, (center_x + width/2)*image_width, (center_y + height/2)*image_height)",
    "ignore_mapping": {
      "IgnoreDontCare": "ignored for Pedestrian and Cyclist",
      "IgnorePersonSitting": "ignored for Pedestrian only"
    }
  },
  "ignore_ioa_threshold": 0.5,
